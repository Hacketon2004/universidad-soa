
# CONFIGURACION DEL PROYECTO SOA

# Base de datos MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=soa_user
MYSQL_PASSWORD=cambiar_password

# Base de datos PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=soa_user
POSTGRES_PASSWORD=cambiar_password

# Base de datos MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017

# Seguridad JWT
JWT_SECRET=reemplazar_por_clave_segura

# Credenciales de Docker - valores de ejemplo
MYSQL_ROOT_PASSWORD=cambiar_root_password

# PostgreSQL utiliza las variables POSTGRES_USER
# y POSTGRES_PASSWORD definidas anteriormente.
